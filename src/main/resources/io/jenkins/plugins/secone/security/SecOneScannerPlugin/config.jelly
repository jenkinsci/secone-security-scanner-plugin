<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form" xmlns:c="/lib/credentials">

	<f:entry>
		<b>Integrates Sec1 Security scanning into your CI/CD pipeline, enabling teams to identify vulnerabilities and security issues early in the development lifecycle.</b>
	</f:entry>
	<f:entry title="Credentials Id" field="apiCredentialsId">
        <f:textbox />
    </f:entry>
    <f:entry title="Scan Mode" field="scanMode" help="/plugin/secone-sca-sast-security-scanner/help-scanMode.html">
        <f:radioBlock name="scanMode" value="api" title="API (default) — scans run on the Sec1 server" inline="true"
                      checked="${instance == null || instance.scanMode != 'cli'}"/>
        <f:radioBlock name="scanMode" value="cli" title="CLI — scans run on the agent (private SCM / registries)" inline="true"
                      checked="${instance.scanMode == 'cli'}">
            <f:entry title="Sec1 CLI Installation" field="cliInstallation">
                <j:choose>
                    <j:when test="${descriptor.hasCliInstallations()}">
                        <f:select/>
                    </j:when>
                    <j:otherwise>
                        <f:readOnlyTextbox value="No Sec1 CLI installations defined. Configure one under Manage Jenkins > Tools."/>
                    </j:otherwise>
                </j:choose>
            </f:entry>
        </f:radioBlock>
    </f:entry>
    <f:entry title="Run SCA Scan" field="runSca">
    	<f:checkbox checked="${instance == null || instance.runSca}"/>
	</f:entry>
    <f:optionalBlock name="runSast" title="Run SAST Scan" inline="true" checked="${instance == null || instance.runSast}">
        <f:entry title="SAST Incremental Scan" field="sastIncrementalScan">
            <f:checkbox checked="${instance.sastIncrementalScan}"/>
        </f:entry>
    </f:optionalBlock>
    <f:entry title="Async Scan (fire-and-forget)" field="asyncScan">
    	<f:checkbox checked="${instance.asyncScan}"/>
	</f:entry>
	<f:entry title="SCM URL" field="scmUrl">
		<f:textbox default="" />
	</f:entry>
	<f:entry title="Scan Tag" field="scanTag">
		<f:textbox default="" />
	</f:entry>
	<f:optionalBlock title="${%thresholdTitle}" field="threshold" checked="${instance.threshold != null}">
        <f:block>
            <table style="padding-left:2%; width:100%;">
                <tr>
                    <td>
                        <f:entry title="${%criticalThresholdTitle}" field="criticalThreshold">
                            <f:textbox default="0" value="${instance.threshold.criticalThreshold}"/>
                        </f:entry>
                    </td>
                    <td>
                        <f:entry title="${%highThresholdTitle}" field="highThreshold">
                            <f:textbox default="10" value="${instance.threshold.highThreshold}"/>
                        </f:entry>
                    </td>
                    <td>
                        <f:entry title="${%mediumThresholdTitle}" field="mediumThreshold">
                            <f:textbox default="" value="${instance.threshold.mediumThreshold}"/>
                        </f:entry>
                    </td>
                    <td>
                        <f:entry title="${%lowThresholdTitle}" field="lowThreshold">
                            <f:textbox default="" value="${instance.threshold.lowThreshold}"/>
                        </f:entry>
                    </td>
                </tr>
                <tr>
                	<td colspan="4">
                		On threshold breached, mark the <b>Build Status</b> as
                	</td>
                </tr>
                <tr>
                	<td>
                		<f:radio name="statusAction" field="statusAction" title="Fail" checked="${instance.threshold.statusAction == 'fail' || !instance.threshold.statusAction}" value="fail"/>
                	</td>
                 	<td>
                 		<f:radio name="statusAction" field="statusAction" title="Unstable" checked="${instance.threshold.statusAction == 'unstable'}" value="unstable"/>
                	</td>
                	<td>
                		<f:radio name="statusAction" field="statusAction" title="Continue" checked="${instance.threshold.statusAction == 'continue'}" value="continue"/>
                	</td>
                </tr>
            </table>
        </f:block>
    </f:optionalBlock>
</j:jelly>
