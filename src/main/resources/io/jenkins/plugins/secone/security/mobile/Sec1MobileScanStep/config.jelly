<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="Credentials Id" field="apiCredentialsId">
        <f:textbox default="SEC1_API_KEY"/>
    </f:entry>
    <f:entry title="Binary Path" field="binaryPath">
        <f:textbox/>
    </f:entry>
    <f:entry title="App Name" field="appName">
        <f:textbox/>
    </f:entry>
    <f:entry title="App Version" field="appVersion">
        <f:textbox/>
    </f:entry>
    <f:entry title="Environment" field="environment">
        <f:textbox/>
    </f:entry>
    <f:entry title="Scan Type" field="scanType">
        <f:select default="owasp"/>
    </f:entry>
    <f:section title="Quality Gate">
        <f:entry title="Fail on Severity" field="failOnSeverity">
            <f:select default="High"/>
        </f:entry>
        <f:entry title="Max Critical" field="maxCritical">
            <f:number clazz="non-negative-number" min="0"/>
        </f:entry>
        <f:entry title="Max High" field="maxHigh">
            <f:number clazz="non-negative-number" min="0"/>
        </f:entry>
        <f:entry title="Max Medium" field="maxMedium">
            <f:number clazz="non-negative-number" min="0"/>
        </f:entry>
        <f:entry title="Minimum Score" field="minScore">
            <f:number clazz="non-negative-number" min="0" max="100"/>
        </f:entry>
        <f:entry title="Mark build unstable instead of failed" field="unstableInsteadOfFail">
            <f:checkbox/>
        </f:entry>
    </f:section>
    <f:advanced>
        <f:entry title="Base URL" field="baseUrl">
            <f:textbox/>
        </f:entry>
        <f:entry title="Source" field="source">
            <f:textbox/>
        </f:entry>
        <f:entry title="Engagement Id" field="engagementId">
            <f:textbox/>
        </f:entry>
        <f:entry title="Poll Interval (seconds)" field="pollIntervalSeconds">
            <f:number default="20" min="10"/>
        </f:entry>
        <f:entry title="Timeout (minutes)" field="timeoutMinutes">
            <f:number default="45" min="1"/>
        </f:entry>
        <f:entry title="Archive findings as a build artifact" field="archiveFindings">
            <f:checkbox default="true"/>
        </f:entry>
    </f:advanced>
</j:jelly>
